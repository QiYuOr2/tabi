{
  "name": "tabi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev --",
    "build": "pnpm --filter web build --",
    "preview": "pnpm --filter web preview --",
    "check": "pnpm --filter web check && pnpm --filter @tabi/intake check",
    "import-photos": "pnpm --filter @tabi/intake import-photos --",
    "match": "pnpm --filter @tabi/intake match --",
    "photos:process": "pnpm --filter @tabi/intake photos:process --"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
